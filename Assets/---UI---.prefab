  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Many moga girls cut their hair short, similar to American flapper girls.
    Long hair was associated with class, wisdom, and beauty. In Shintoism, hair is
    considered a source of spiritual power. Cutting one\u2019s hair was often symbolic
    of a rite of passage, especially a passage from life to death."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
